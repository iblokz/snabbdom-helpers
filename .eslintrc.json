{
	"env": {
		"es6": true,
		"browser": true,
		"node": true,
		"mocha": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"extends": "google",
	"rules": {
		"indent": ["error", "tab", {"SwitchCase": 1}],
		"max-len": ["warn", 120, {"tabWidth": 2}],
		"no-tabs": 0,
		"no-nested-ternary": 0,
		"operator-linebreak": 0,
		"no-return-assign": ["error", "except-parens"],
		"no-sequences": 0,
		"dot-notation": 0,
		"no-negated-condition": 0,
		"no-unused-vars": 0,
		"no-loop-func": 0,
		"no-warning-comments": 0,
		"comma-dangle": ["error", "never"],
		"prefer-rest-params": 0
	}
}
